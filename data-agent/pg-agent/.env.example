# Database Configuration
DB_TYPE=postgres          # postgres | mysql | mssql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=postgres
DB_PASSWORD=secret
DB_SCHEMA=public          # schema whose tables get auto-exposed

# (Optional) SQL Server Driver
# DB_DRIVER=ODBC Driver 17 for SQL Server

# Or supply a full DSN directly (overrides individual fields above):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# OpenAI (required only for /api/nlq/ask endpoint)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# API behaviour
DEFAULT_LIMIT=100         # default rows per page
MAX_LIMIT=1000            # hard row cap

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=*
